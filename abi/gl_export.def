# Hematite GL/EGL export table.
#
# This file is the single source of truth for the C ABI Hematite exposes.
# `xtask gen-abi` turns it into `crates/hematite-gl-frontend/src/gen/abi.rs`.
#
# Format: one entry per line, tab-separated:
#   <name>  <return type>  <param types, comma separated>  <canvas class>  <since version>
#
# `return type` and `param types` use the C spellings from the Khronos headers
# (GLenum, GLuint, GLsizei, GLsizeiptr, GLintptr, GLboolean, ...). The generator maps
# these to fixed-width Rust types, which is what makes the table auditable: there is
# exactly one line to check against glcorearb.h / eglext.h for each function.
#
# Canvas classes tell the frontend what the entry point does before the backend sees it:
#   state     - mutates tracked GL state only; no backend command emitted
#   resource  - creates/destroys a named object
#   draw      - records geometry
#   query     - reads state back (synchronous; see ARCHITECTURE.md §3)
#   sync      - forces the command ring to be drained
#   unsupported - exported, logs once, raises GL_INVALID_OPERATION
#
# `since` is the GL/EGL version that introduced the function; used for GL_VERSION
# dependent behaviour and for test coverage targets.

# --- EGL 1.4 / 1.5 (the renderer IS the EGL implementation) ---

eglGetDisplay	EGLDisplay	EGLNativeDisplayType	target	1.4
eglGetPlatformDisplay	EGLDisplay	EGLenum,void*,const EGLAttrib*	target	1.5
eglGetPlatformDisplayEXT	EGLDisplay	EGLenum,void*,const EGLint*	target	1.5
eglInitialize	EGLBoolean	EGLDisplay,EGLint*,EGLint*	target	1.4
eglTerminate	EGLBoolean	EGLDisplay	target	1.4
eglQueryString	const char*	EGLDisplay,EGLint	query	1.4
eglQueryDisplayAttribEXT	EGLBoolean	EGLDisplay,EGLint,EGLAttrib*	query	1.5
eglChooseConfig	EGLBoolean	EGLDisplay,const EGLint*,EGLConfig*,EGLint,EGLint*	target	1.4
