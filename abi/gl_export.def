eglGetConfigAttrib	EGLBoolean	EGLDisplay,EGLConfig,EGLint,EGLint*	query	1.4
eglCreateWindowSurface	EGLSurface	EGLDisplay,EGLConfig,EGLNativeWindowType,const EGLint*	target	1.4
eglCreatePbufferSurface	EGLSurface	EGLDisplay,EGLConfig,const EGLint*	target	1.4
eglCreatePixmapSurface	EGLSurface	EGLDisplay,EGLConfig,EGLNativePixmapType,const EGLint*	target	1.4
eglDestroySurface	EGLBoolean	EGLDisplay,EGLSurface	target	1.4
eglQuerySurface	EGLBoolean	EGLDisplay,EGLSurface,EGLint,EGLint*	query	1.4
eglBindAPI	EGLBoolean	EGLenum	target	1.4
eglQueryAPI	EGLenum	void	target	1.4
eglWaitClient	EGLBoolean	void	sync	1.4
eglReleaseThread	EGLBoolean	void	target	1.4
eglCreateContext	EGLContext	EGLDisplay,EGLConfig,EGLContext,const EGLint*	target	1.4
eglDestroyContext	EGLBoolean	EGLDisplay,EGLContext	target	1.4
eglMakeCurrent	EGLBoolean	EGLDisplay,EGLSurface,EGLSurface,EGLContext	target	1.4
eglGetCurrentContext	EGLContext	void	query	1.4
eglGetCurrentSurface	EGLSurface	EGLint	query	1.4
eglGetCurrentDisplay	EGLDisplay	void	query	1.4
eglQueryContext	EGLBoolean	EGLDisplay,EGLContext,EGLint,EGLint*	query	1.4
eglWaitGL	EGLBoolean	void	sync	1.4
eglWaitNative	EGLBoolean	EGLint	sync	1.4
eglSwapBuffers	EGLBoolean	EGLDisplay,EGLSurface	sync	1.4
